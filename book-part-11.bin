","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"Cough & Coffee Club — Nighttime","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"Cough & Coffee Club — Sunset","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"Cough & Coffee Club — Coffee by the Sea","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"Cough & Coffee Club — Moonlight","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"Cough & Coffee Club — Moonlight Revised","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"Cough & Coffee Club — Sunset Café","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"Daily Joe Philosophy — Better To Do Nothing","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"The COPD Peace Conference","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"The COPD Peace Conference — Revised","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"COPD Research — The Piña Colada Experiment","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"A Bump in the Road — Still My Saturday","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5},{"title":"Some People Rescue Turtles","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Community & gratitude","_v1705Order":6},{"title":"Save The Turtles — I Rescue Trash Monsters","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Community & gratitude","_v1705Order":6},{"title":"Care Comes From the Heart","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Community & gratitude","_v1705Order":6},{"title":"To Those Who Care — Thank You","date":"","text":"To Those Who Care... Thank You. ❤️\n\nToday, seeing the love, patience and dedication shown to disabled children made me stop and reflect.\n\nIt made me think about the incredible people who dedicate their lives to looking after others. Carers, nurses, therapists, teachers, volunteers, parents, families and so many more.\n\nOver the years, I've experienced what it feels like to be completely helpless and dependent on others, even for the simplest things in life.\n\nAnd I've learned that there's an enormous difference between being looked after and genuinely feeling cared for.\n\nSometimes it's the smallest gestures that leave the deepest impressions. A smile, a little patience, a reassuring word or simply being treated as a human being.\n\nSo, to all those wonderful people who quietly dedicate their time, energy and love to making life a little easier for others...\n\n𝗧𝗵𝗮𝗻𝗸 𝗬𝗼𝘂. ❤️\n\nYour kindness, compassion and dedication often go unnoticed, but they make a world of difference.\n\nYou don't just provide care. You provide dignity, hope, comfort and a better quality of life.\n\nYou are appreciated more than you probably realise. ❤️\n\nJoe Ling","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Community & gratitude","_v1705Order":6},{"title":"Humbleness & Dignity","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Community & gratitude","_v1705Order":6},{"title":"Humbleness & Dignity — Revised","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Community & gratitude","_v1705Order":6},{"title":"Illness, Hope & Religion","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Beliefs & reflections","_v1705Order":7},{"title":"Illness, Hope & Religion — Revised","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Beliefs & reflections","_v1705Order":7},{"title":"Exercise, Meditation & Destiny","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/webp;base64,","video":"","_v1705Poster":true,"_v1705Category":"Beliefs & reflections","_v1705Order":7},{"title":"Exercise, Meditation & Destiny — Revised","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Beliefs & reflections","_v1705Order":7},{"title":"Medical Support and Personal Groundwork","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Mindset & daily life","_v1705Order":3},{"title":"Keeping Going — Original Poster","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Personal reflections","_v1705Order":2},{"title":"A Bump in the Road — Original Poster","date":"","text":"Poster from my original collection. Artwork only — no article text was supplied with this image.","image":"data:image/jpeg;base64,","video":"","_v1705Poster":true,"_v1705Category":"Coffee Club & humour","_v1705Order":5}];


// V1.01: Twenty-five editable placeholders, positions 20 through 44.
const SLOT_KEY='joe-copd-book-v101-slots';
const embeddedBookNode=document.getElementById('book-snapshot');
let embeddedBook=null;
try{if(embeddedBookNode&&embeddedBookNode.textContent.trim())embeddedBook=JSON.parse(embeddedBookNode.textContent)}catch(e){console.error('Embedded book could not be read',e)}
let articleSlots={};
try{articleSlots=embeddedBook?embeddedBook.slots||{}:{}}catch(e){articleSlots={}}
function saveSlots(){/* In-memory edits only; use Export Complete Book to persist. */}
function slotEditor(i){
 const a=articleSlots[i]||{title:'',date:'',text:'',image:'',video:''};
 showModal(`<h2>${a.title?'Edit':'Add'} Article ${i+1}</h2><p class="muted">Add a title, picture and article text. Export Complete Book to preserve everything in one HTML file.</p><label>Article title</label><input id="slot-title" value="${esc(a.title)}"><label>Date (optional)</label><input id="slot-date" value="${esc(a.date)}"><label>Picture</label><input type="file" id="slot-picture" accept="image/*"><label>Video (optional)</label><input type="file" id="slot-video" accept="video/*"><label>Article text</label><textarea id="slot-text" rows="12">${esc(a.text)}</textarea><div class="actions"><button onclick="saveSlot(${i})">Save Article</button>${a.title?`<button onclick="clearSlot(${i})">Clear Article</button>`:''}<button onclick="closeModal()">Cancel</button></div>`);
}
async function saveSlot(i){
 const title=document.getElementById('slot-title').value.trim();
 if(!title){alert('Please enter an article title.');return}
 const old=articleSlots[i]||{};
 let image=old.image||'',video=old.video||'';
 const pic=document.getElementById('slot-picture').files[0];
 if(pic)image=await new Promise((resolve,reject)=>{let r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(pic)});
 const vf=document.getElementById('slot-video').files[0];
 if(vf)video=await new Promise((resolve,reject)=>{let r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(vf)});
 articleSlots[i]={title,date:document.getElementById('slot-date').value.trim(),text:document.getElementById('slot-text').value,image,video};
 saveSlots();closeModal();current=buildPages().starts[i];render();
}
function clearSlot(i){if(confirm('Clear Article '+(i+1)+'?')){delete articleSlots[i];saveSlots();closeModal();current=buildPages().starts[i];render()}}
function slotVideoMarkup(a){return a.video?`<video controls preload="metadata" class="article-video" src="${esc(a.video)}"></video>`:''}
function exportCompleteBook(){
 try{
  const snap=document.getElementById('book-snapshot');
  snap.textContent=JSON.stringify({data,slots:articleSlots}).replace(/</g,'\\u003c');
  const html='<!DOCTYPE html>\n'+document.documentElement.outerHTML;
  const blob=new Blob([html],{type:'text/html;charset=utf-8'});
  const url=URL.createObjectURL(blob),a=document.createElement('a');
  a.href=url;a.download='joe_ling_interactive_book_complete.html';document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),30000);
 }catch(e){alert('Export failed: '+e.message)}
}

function buildPages(){
 if(embeddedBook && embeddedBook.data && Array.isArray(embeddedBook.data.articles) && !embeddedBook._loaded){data=embeddedBook.data;embeddedBook._loaded=true;}
 const originalArticles=data.articles.map((a,i)=>({...a,_sourceIndex:i,_v1705Order:/Greetings Everyone.*Introduce Myself/i.test(a.title)?0:/glossary/i.test(a.title)?99:/cough|coffee|philosophy|humou?r|piña|cappuccino/i.test(a.title)?5:/oxygen|inhaler|medic|rehab|breath|rescue|treatment|herbs|oximeter/i.test(a.title)?4:2}));
 let viewArticles=[...originalArticles,...V1705_GALLERY.map(a=>({...a,_sourceIndex:-1}))].sort((a,b)=>a._v1705Order-b._v1705Order).filter((a,i)=>![2,3,14,17,21].includes(i+1)); // Requested removals from V17.05 article numbering
 // V17.09: move the articles numbered 22–29 in V17.08 immediately after article 7.
 // Slice from the existing displayed order so numbering matches the reader's index.
 const relocated=viewArticles.splice(21,8);
 viewArticles.splice(7,0,...relocated);
 // V17.10: remove articles 33, 35, 37–41 using the V17.09 displayed numbering.
 viewArticles=viewArticles.filter((a,i)=>![33,35,37,38,39,40,41].includes(i+1));
 // V17.11: keep video articles together near the end, immediately before the glossary.
 // Preserve the existing relative order of both video and non-video articles.
 const videoArticles=viewArticles.filter(a=>typeof a.video==='string' && a.video.trim()!=='');
 const otherArticles=viewArticles.filter(a=>!(typeof a.video==='string' && a.video.trim()!==''));
 const glossaryAt=otherArticles.findIndex(a=>/glossary/i.test(a.title||''));
 otherArticles.splice(glossaryAt>=0?glossaryAt:otherArticles.length,0,...videoArticles);
 viewArticles=otherArticles;
 // V17.14: retain the original V17.13 numbering when removing selected articles.
 // Remember the title-free left page of former Article 17; former Article 25 is removed.
 viewArticles=viewArticles.map((a,i)=>({...a,_hideLeftTitle:i===16})).filter((a,i)=>![25,39,42,47,49].includes(i+1));
 // V17.15: hide only the picture-side titles on current articles 24 and 26.
 viewArticles=viewArticles.map((a,i)=>({...a,_hideLeftTitle:a._hideLeftTitle || i===23 || i===25}));
 // V17.18: remove current articles 46 and 48; regenerate contents and page links from remaining articles.
 viewArticles=viewArticles.filter((a,i)=>![46,48].includes(i+1));
 // V17.19: remove article 43 using V17.18 numbering.
 viewArticles=viewArticles.filter((a,i)=>i!==42);
 // V17.22: preserve article identity when moving original #17 and #24.
 viewArticles=viewArticles.map((a,i)=>({...a,
   _largeCenteredPoster:i===16 || i===23 || i===35,
   _wasArticle17:i===16,
   _wasArticle24:i===23
 }));
 const moved17=viewArticles[16], moved24=viewArticles[23];
 viewArticles=viewArticles.filter(a=>a!==moved17 && a!==moved24);
 viewArticles.splice(33,0,moved17,moved24); // New positions 34 and 35.
 // V17.23: remove displayed Article 48 after the V17.22 reordering.
 viewArticles=viewArticles.filter((a,i)=>i!==47);
  // V17.24: move current Article 24 after current Article 35.
  const relocated24=viewArticles.splice(23,1)[0];
  viewArticles.splice(34,0,relocated24);
  relocated24._largeCenteredPoster=true;
  // V17.26: move displayed Article 43 to position 36, retaining its poster and text.
  const relocated43=viewArticles.splice(42,1)[0];
  if(relocated43) viewArticles.splice(35,0,relocated43);
  // Remove the editorial suffix from article titles without changing the article content.
  viewArticles=viewArticles.map(a=>({...a,title:(a.title||'').replace(/\s*[-–—]\s*REVISED\b/gi,'').trim()}));
  // V17.25: replace the poster of displayed Article 50 only.
  if(viewArticles[49]) viewArticles[49].image='data:image/png;base64,