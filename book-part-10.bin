","video":""},{"title":"Ways to Open the Bronchial Tubes","date":"","text":"","image":"data:image/png;base64,","video":""},{"title":"Did You Know? — COPD Facts and Curiosities","date":"","text":"","image":"data:image/webp;base64,","video":""},{"title":"COPD Glossary","date":"","text":"","image":"data:image/webp;base64,","video":""}];
{
  const known = new Set(data.articles.map(a => a.title.toLocaleLowerCase().trim()));
  const newPosters = V1702_POSTERS.filter(a => !known.has(a.title.toLocaleLowerCase().trim()));
  // New educational chapters first, legacy chapters retained in their existing order.
  const glossary = newPosters.filter(a => a.title === 'COPD Glossary');
  const others = newPosters.filter(a => a.title !== 'COPD Glossary');
  data.articles = [...others, ...data.articles.filter(a => a.title !== 'COPD Glossary'),
                   ...data.articles.filter(a => a.title === 'COPD Glossary'), ...glossary];
}


// V17.03: User-supplied original About Me poster. Preserve any existing article text.
{
  const aboutTitle='Greetings Everyone — Let Me Introduce Myself';
  const aboutImage='data:image/png;base64,';
  let about=data.articles.find(a=>/Greetings Everyone.*Introduce Myself/i.test(a.title));
  if(about){about.image=aboutImage.trim();}
  else {
    about={title:aboutTitle,date:'',text:'',image:aboutImage.trim(),video:''};
    const insertAt=data.articles.findIndex(a=>a.title==='Are You Using Your Inhaler Correctly?');
    data.articles.splice(insertAt>=0?insertAt:2,0,about);
  }
}

// V17.04: Place About Me immediately after the index (first article).
{
  const aboutAt=data.articles.findIndex(a=>/Greetings Everyone.*Introduce Myself/i.test(a.title));
  if(aboutAt>0){const [about]=data.articles.splice(aboutAt,1);data.articles.unshift(about);}
}


