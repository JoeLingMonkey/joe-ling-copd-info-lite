";
function videoMarkup(a){return a.video?`<video controls preload="metadata" class="article-video" data-video="${esc(a.video)}"${a.video==="builtin-invisible-struggle"?' src="'+BUILTIN_VIDEO+'"':a.video==="builtin-life-in-verse"?' src="'+LIFE_IN_VERSE_VIDEO+'"':a.video==="builtin-apocalypse"?' src="'+APOCALYPSE_VIDEO+'"':a.video.startsWith('data:video/')?' src="'+esc(a.video)+'"':""}></video>`:''}
function splitText(text,firstLimit=600,otherLimit=1150){
 const paras=String(text||'').split(/\n/), chunks=[];let part='',limit=firstLimit;
 for(const para of paras){
   const words=para.split(/(\s+)/);let line='';
   for(const w of words){
     if((part+line+w).length>limit && (part+line).trim()){
       chunks.push((part+line).trim());part='';line='';limit=otherLimit;
     }
     line+=w;
   }
   if((part+line+'\n').length>limit && part.trim()){
     chunks.push(part.trim());part='';limit=otherLimit;
   }
   part+=line+'\n';
 }
 if(part.trim()||!chunks.length)chunks.push(part.trim());
 return chunks;
}
function fitWords(words,start,head,withHeading){
 const probe=document.getElementById('page-measure');
 if(!probe)return Math.min(words.length-start,180);
 const inner=probe.querySelector('.article-text');
 const header=probe.querySelector('.measure-header');
 header.innerHTML=head;
 const limit=probe.getBoundingClientRect().top+probe.clientHeight*0.73;
 let lo=0,hi=words.length-start,best=0;
 while(lo<=hi){
   const mid=Math.floor((lo+hi)/2);
   inner.textContent=words.slice(start,start+mid).join('').trim();
   const bottom=inner.getBoundingClientRect().bottom;
   if(bottom<=limit){best=mid;lo=mid+1}else hi=mid-1;
 }
 return Math.max(1,best);
}
function refreshMeasure(){
 const el=document.getElementById('page-measure');
 if(!el)return;
 const book=document.getElementById('book');
 el.style.width=(book.clientWidth/2-3)+'px';
 el.style.height=(book.clientWidth*0.81)+'px';
}
