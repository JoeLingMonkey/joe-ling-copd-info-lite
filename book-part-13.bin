 // V18.03: Append user-provided COPD glossary to Article 19 only.
 if(viewArticles[18]) { viewArticles[18].title = "GLOSSARY"; viewArticles[18].text = "🔹 𝗕𝗿𝗲𝗮𝘁𝗵𝗶𝗻𝗴 & 𝗦𝘆𝗺𝗽𝘁𝗼𝗺𝘀\n𝐒𝐎𝐁 (Short of Breath) → Common shorthand for breathlessness.\n“𝐈 𝐂𝐀𝐍’𝐓 𝐁𝐑𝐄𝐀𝐓𝐇𝐄” → A symptom, not a diagnosis; could be COPD flare, infection, or panic.\n𝐃𝐘𝐒𝐏𝐍𝐄𝐀 → Medical word for breathlessness/SOB.\n𝐁𝐀𝐒𝐄𝐋𝐈𝐍𝐄 → Your usual day-to-day level of symptoms.\n\n🔹 𝗙𝗹𝗮𝗿𝗲-𝘂𝗽𝘀 & 𝗘𝘅𝗮𝗰𝗲𝗿𝗯𝗮𝘁𝗶𝗼𝗻𝘀\n𝐅𝐋𝐀𝐑𝐄-𝐔𝐏 →A short, sudden worsening of symptoms (more breathlessness, cough, mucus). Often settles in a day or two, sometimes with just your rescue inhaler.\n𝐄𝐗𝐀𝐂𝐄𝐑𝐁𝐀𝐓𝐈𝐎𝐍 → A more serious flare-up that lasts longer (days or weeks) and usually needs treatment (steroids, antibiotics, or hospital care).\n𝐂𝐇𝐄𝐒𝐓 𝐈𝐍𝐅𝐄𝐂𝐓𝐈𝐎𝐍 → Lung infection (bronchitis, pneumonia) that often triggers exacerbations.\n\n🔹 𝗔𝗶𝗿𝘄𝗮𝘆 & 𝗟𝘂𝗻𝗴 𝗙𝘂𝗻𝗰𝘁𝗶𝗼𝗻\n𝐁𝐑𝐎𝐍𝐂𝐇𝐎𝐒𝐏𝐀𝐒𝐌 → Airways tighten, causing sudden SOB and wheezing.\n𝐌𝐔𝐂𝐔𝐒 → Produced in the airways.\n𝐏𝐇𝐋𝐄𝐆𝐌 → Thicker mucus that you cough up.\n𝐒𝐏𝐔𝐓𝐔𝐌 → Medical term for phlegm when tested.\n𝐀𝐈𝐑 𝐓𝐑𝐀𝐏𝐏𝐈𝐍𝐆 → Air gets stuck in the lungs, making it hard to fully exhale.\n𝐇𝐘𝐏𝐄𝐑𝐈𝐍𝐅𝐋𝐀𝐓𝐈𝐎𝐍 → Lungs stay expanded because of trapped air.\n\n🔹 𝗢𝘅𝘆𝗴𝗲𝗻 & 𝗚𝗮𝘀 𝗘𝘅𝗰𝗵𝗮𝗻𝗴𝗲\n𝐎𝐗𝐘𝐆𝐄𝐍 𝐃𝐄𝐒𝐀𝐓𝐔𝐑𝐀𝐓𝐈𝐎𝐍 (“desat”) → When oxygen drops below your baseline.\n𝐇𝐘𝐏𝐎𝐗𝐈𝐀 → Low oxygen in tissues.\n𝐇𝐘𝐏𝐎𝐗𝐄𝐌𝐈𝐀 → Low oxygen in the blood.\n𝐇𝐘𝐏𝐄𝐑𝐂𝐀𝐏𝐍𝐈𝐀 → Too much carbon dioxide (CO₂) in the blood; can cause confusion, headaches, drowsiness.\n\n🔹 𝗠𝗲𝗻𝘁𝗮𝗹 𝗛𝗲𝗮𝗹𝘁𝗵 & 𝗕𝗿𝗲𝗮𝘁𝗵𝗶𝗻𝗴\n𝐏𝐀𝐍𝐈𝐂 𝐀𝐓𝐓𝐀𝐂𝐊 → Sudden, intense fear reaction with fast heartbeat, chest tightness, SOB.\n𝐀𝐍𝐗𝐈𝐄𝐓𝐘 𝐀𝐓𝐓𝐀𝐂𝐊 → Gradual build-up of worry/anxiety making breathing feel worse.\n\n🔹 𝗠𝗲𝗱𝗶𝗰𝗮𝗹 𝗧𝗲𝘀𝘁𝘀 & 𝗠𝗲𝗮𝘀𝘂𝗿𝗲𝗺𝗲𝗻𝘁𝘀\n𝐅𝐄𝐕₁ (Forced Expiratory Volume in 1 second) → Air you can blow out in the first second of a forced breath.\n𝐅𝐕𝐂 (Forced Vital Capacity) → Total air blown out after a deep breath.\n𝐅𝐄𝐕/𝐅𝐕𝐂 𝐑𝐀𝐓𝐈𝐎 → Used to diagnose and stage COPD.\n𝐏𝐔𝐋𝐒𝐄 𝐎𝐗𝐈𝐌𝐄𝐓𝐄𝐑 (“Pulse ox”) → Finger clip that estimates oxygen saturation (SpO₂).\n𝐒𝐩𝐎₂ (%) → Peripheral oxygen saturation — % of oxygen in the blood measured by pulse oximeter. Normal is usually 95–100%, but many COPD patients run lower.\n𝐏𝐈% (Perfusion Index) → Shows how strong the pulse signal is at the sensor site (helps judge accuracy of SpO₂ reading).\n𝐏𝐔𝐋𝐒𝐄 (HR, bpm) → Heart rate in beats per minute, shown on the oximeter.\n𝐀𝐁𝐆 (Arterial Blood Gas) → Blood test from an artery that directly measures oxygen and CO₂.\n\n🔹 𝗧𝗿𝗲𝗮𝘁𝗺𝗲𝗻𝘁𝘀 & 𝗠𝗮𝗻𝗮𝗴𝗲𝗺𝗲𝗻𝘁\n𝐑𝐄𝐒𝐂𝐔𝐄 𝐈𝐍𝐇𝐀𝐋𝐄𝐑 → Fast-acting (e.g., albuterol/Ventolin) for sudden SOB.\n𝐌𝐀𝐈𝐍𝐓𝐄𝐍𝐀𝐍𝐂𝐄 𝐈𝐍𝐇𝐀𝐋𝐄𝐑 → Daily inhaler (LABA, LAMA, steroids) to keep lungs stable.\n𝐍𝐄𝐁𝐔𝐋𝐈𝐙𝐄𝐑 (Nebs) → Machine that delivers medicine in a mist.\n𝐒𝐓𝐄𝐑𝐎𝐈𝐃𝐒 → (e.g., prednisone) used short-term for exacerbations.\n𝐀𝐍𝐓𝐈𝐁𝐈𝐎𝐓𝐈𝐂𝐒 → Prescribed if infection suspected.\n𝐏𝐔𝐋𝐌𝐎𝐍𝐀𝐑𝐘 𝐑𝐄𝐇𝐀𝐁→ Exercise + education program to improve stamina.\n𝐎𝐗𝐘𝐆𝐄𝐍 𝐓𝐇𝐄𝐑𝐀𝐏𝐘 → Prescribed oxygen, continuous or as needed.\n\n🔹 𝗕𝗿𝗲𝗮𝘁𝗵𝗶𝗻𝗴 𝗧𝗲𝗰𝗵𝗻𝗶𝗾𝘂𝗲𝘀\n𝐏𝐔𝐑𝐒𝐄𝐃-𝐋𝐈𝐏 𝐁𝐑𝐄𝐀𝐓𝐇𝐈𝐍𝐆 → Inhale through the nose, exhale slowly through lips as if blowing out a candle. Helps keep airways open, reduce trapped air, and calm panic.\n𝐃𝐈𝐀𝐏𝐇𝐑𝐀𝐆𝐌𝐀𝐓𝐈𝐂 (𝐁𝐄𝐋𝐋𝐘) 𝐁𝐑𝐄𝐀𝐓𝐇𝐈𝐍𝐆 → Breathe from the diaphragm instead of the chest. Put a hand on your belly, inhale deeply so the belly rises, exhale slowly. Strengthens breathing muscles and improves oxygen exchange.\n𝐁𝐎𝐗 𝐁𝐑𝐄𝐀𝐓𝐇𝐈𝐍𝐆 → Inhale for 4 seconds → Hold 4 seconds → Exhale 4 seconds → Hold 4 seconds. Helpful for anxiety and regaining rhythm when SOB.\n𝐂𝐎𝐎𝐑𝐃𝐈𝐍𝐀𝐓𝐄𝐃 𝐁𝐑𝐄𝐀𝐓𝐇𝐈𝐍𝐆→ Inhale before exertion, exhale during effort (e.g., inhale before standing, exhale while standing up). Prevents breath-holding during activity.\n𝐇𝐔𝐅𝐅 𝐂𝐎𝐔𝐆𝐇𝐈𝐍𝐆  → Inhale a medium breath, then exhale forcefully saying “huff, huff, huff” like fogging a mirror. Helps clear mucus without exhausting the lungs.\n𝐏𝐀𝐂𝐄𝐃 𝐁𝐑𝐄𝐀𝐓𝐇𝐈𝐍𝐆  → Match your breathing to your steps or movements (e.g., inhale for 2 steps, exhale for 4 steps). Makes walking/exercise easier.\n𝐑𝐄𝐒𝐎𝐍𝐀𝐍𝐂𝐄 𝐁𝐑𝐄𝐀𝐓𝐇𝐈𝐍𝐆  (slow breathing) Breathe at about 5–6 breaths per minute. Can lower stress, improve heart-lung coordination.\n\n🔹 𝗗𝗶𝘀𝗲𝗮𝘀𝗲 𝗦𝘁𝗮𝗴𝗲𝘀 & 𝗥𝗶𝘀𝗸𝘀\n𝐂𝐎𝐏𝐃 𝐒𝐓𝐀𝐆𝐄𝐒 (GOLD 1–4) → Based on lung test results: mild, moderate, severe, very severe.\n𝐂𝐎𝐑 𝐏𝐔𝐋𝐌𝐎𝐍𝐀𝐋𝐄 → Heart strain caused by long-term low oxygen.\n𝐄𝐗𝐄𝐑𝐓𝐈𝐎𝐍𝐀𝐋 𝐃𝐘𝐒𝐏𝐍𝐄𝐀→ Breathlessness on activity or effort.\n𝐂𝐎𝐌𝐎𝐑𝐁𝐈𝐃𝐈𝐓𝐘 → Other health conditions alongside COPD (e.g., heart disease, diabetes).\n“𝐁𝐋𝐔𝐄 𝐁𝐋𝐎𝐀𝐓𝐄𝐑” / “𝐏𝐈𝐍𝐊 𝐏𝐔𝐅𝐅𝐄𝐑” → Old terms (not really used now) for COPD types."; }
 const v1795TextMarkup=(a,i)=>{
   const escaped=esc(v1795ArticleBody(a,i));
   if(i===1) return escaped.replace(/^(\s*)(\([^\r\n]*\))/,(_,lead,bracket)=>lead+'<span class="article-two-bracket">'+bracket+'</span>').replace(/<\/span>(?:\r?\n)+/, '</span>');
   if(i===8) return escaped.split(/(?:\r?\n){2,}/).filter(part=>part.trim()).map(part=>'<p style="margin:0 0 1.1em 0;white-space:pre-wrap;">'+part+'</p>').join('');
   return escaped;
 };
