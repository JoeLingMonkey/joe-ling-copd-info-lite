<style>.spread.single-page .replacement-warning-picture{width:100%;height:100%;display:flex;align-items:center;justify-content:center}.spread.single-page .replacement-warning-picture img{display:block;width:100%;height:auto;max-height:100%;object-fit:contain}</style>
<style>.replacement-welcome-picture{width:100%;height:100%;display:flex;align-items:center;justify-content:center}.replacement-welcome-picture img{display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}.spread.single-page:has(.replacement-welcome-picture)>.page{padding:0!important;overflow:hidden!important}</style><style>/* V2.13: Health Warning illustration fills its single book page. */
.spread.single-page:has(.replacement-warning-picture){aspect-ratio:1056/1536!important}
.spread.single-page:has(.replacement-warning-picture)>.page{padding:0!important;overflow:hidden!important}
