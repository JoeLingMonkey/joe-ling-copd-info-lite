.spread.single-page .replacement-warning-picture img{display:block!important;width:100%!important;height:100%!important;max-width:none!important;max-height:none!important;object-fit:fill!important;margin:0!important}
</style><style>/* V2.14: Page 2 welcome illustration fills its book leaf, matching Page 3 treatment. */
.spread.single-page:has(.replacement-welcome-picture){aspect-ratio:1152/1536!important}
.spread.single-page:has(.replacement-welcome-picture)>.page{padding:0!important;overflow:hidden!important}
.spread.single-page .replacement-welcome-picture{width:100%!important;height:100%!important;margin:0!important;padding:0!important;display:block!important}
.spread.single-page .replacement-welcome-picture img{display:block!important;width:100%!important;height:100%!important;max-width:none!important;max-height:none!important;object-fit:fill!important;margin:0!important}
</style><style>/* V2.25: First three leaves share the same geometry as the existing index leaf. No changes to index or later pages. */
.fullspread.single-cover,
