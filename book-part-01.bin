<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,user-scalable=yes"><title>My Writings & Reflections — Living with COPD</title><style>
:root{--ink:#25143c;--red:#a51b28;--paper:#f7e4b9}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#3b4255,#11151c 80%);color:#fff;font-family:Georgia,serif;min-height:100vh}header{padding:15px 20px;display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}header h1{font-size:clamp(18px,3vw,27px);margin:0}header small{display:block;color:#e5c98b}button,.filebtn{border:1px solid #c99c55;background:#f8df9e;color:#301b21;border-radius:9px;padding:10px 13px;font-weight:700;cursor:pointer;font-size:14px}button:hover,.filebtn:hover{background:#fff1c8}button:disabled{opacity:.35;cursor:default}.toolbar{display:flex;gap:7px;flex-wrap:wrap}.book-wrap{max-width:1200px;margin:12px auto;padding:0 12px}.book{background:#7e4827;border:8px ridge #ac7845;border-radius:15px;box-shadow:0 15px 50px #0009;overflow:hidden;position:relative;min-height:450px}.spread{display:grid;grid-template-columns:1fr 1fr;min-height:560px}.page{background:linear-gradient(100deg,#c89b5d 0%,#f8e8c6 7%,#fff0d0 85%,#dbb77e 100%);color:var(--ink);padding:clamp(18px,3vw,42px);position:relative;box-shadow:inset 0 0 35px #9b603c45;overflow-wrap:anywhere}.page:first-child{border-right:3px solid #9a6c45}.page h2{font-family:'Brush Script MT','Segoe Print',Georgia,cursive;font-style:italic;font-size:clamp(27px,3.6vw,46px);color:#36164c;margin:0 0 16px}.page h3{font-size:23px}.page p{font-size:clamp(16px,1.7vw,21px);line-height:1.65}.page .decor{border-bottom:2px solid #ad3044;padding-bottom:10px}.page .bottom{position:absolute;bottom:12px;right:24px;font-size:13px;color:#815b50}.imagepage{padding:0;background:#251e26}.imagepage img{width:100%;height:100%;object-fit:cover;object-position:left center;display:block}.fullspread{width:100%;display:block}.fullspread img{width:100%;display:block}.nav{display:flex;justify-content:space-between;align-items:center;gap:10px;max-width:1200px;margin:12px auto;padding:0 14px}.nav button{font-size:11px;padding:5px 8px;border-radius:5px}.toolbar button,.toolbar .filebtn{font-size:11px;padding:6px 8px;border-radius:5px}.nav span{text-align:center;color:#f7e2b4}.indexrow{display:block;width:100%;text-align:left;margin:7px 0;background:#fff6df;border:1px solid #caa97b;padding:11px;color:#351c3b}.article-banner{width:100%;max-height:260px;object-fit:cover;border:5px solid #fff8e7;box-shadow:0 3px 10px #6349}.article-text{white-space:pre-wrap;line-height:1.7;font-size:19px;overflow-wrap:anywhere}.article-layout{display:block}.article-layout .page{min-height:560px;padding:clamp(20px,4vw,55px);width:100%;height:auto;overflow:visible}.article-layout .article-banner{display:block;max-width:100%;height:auto;max-height:360px;margin:18px auto 24px}.article-layout .article-text{max-width:850px;margin:18px auto}.article-layout .page h2,.article-layout .date{max-width:850px;margin-left:auto;margin-right:auto}.article-layout .article-actions{max-width:850px;margin:24px auto 0}.date{color:#79504a;font-style:italic}.warning{background:#f6d991;border:5px solid #211915;padding:14px;text-align:center;max-width:550px;margin:22px auto;box-shadow:0 5px 14px #0003}.warning strong{font-size:25px}.warning p{font-size:clamp(12px,1.35vw,16px);line-height:1.4}.warning strong{font-size:clamp(14px,1.8vw,23px)}.notices{border:2px solid #b82c45;border-radius:25px;min-height:280px;padding:20px;white-space:pre-wrap}.flower{text-align:center;font-size:42px;margin-top:35px}.modalback{position:fixed;inset:0;background:#000c;z-index:5;display:none;align-items:center;justify-content:center;padding:12px}.modalback.show{display:flex}.modal{background:#fff0d1;color:#281932;border:5px ridge #b78a4c;border-radius:13px;max-width:720px;width:100%;max-height:94vh;overflow:auto;padding:20px}.modal h2{margin-top:0}.modal label{display:block;margin:12px 0 5px;font-weight:bold}.modal input,.modal textarea{width:100%;padding:10px;border:1px solid #a48b6a;border-radius:6px;font:16px Georgia;background:#fffaf0}.modal textarea{min-height:190px}.modal .actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.muted{opacity:.7;font-size:14px}.hide{display:none!important}@media(max-width:650px){.spread{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:unset}.page{min-height:420px}.page:first-child{border-right:2px solid #9a6c45;border-bottom:0}.book{min-height:unset}.nav{position:sticky;bottom:0;background:#141922ed;padding:10px}.page{padding:10px;min-width:0}.page h2{font-size:clamp(15px,3.3vw,27px)}.page p{font-size:clamp(10px,2.3vw,17px);line-height:1.45}.warning{padding:6px;border-width:2px;margin:8px auto}.warning p{font-size:clamp(9px,2vw,14px)}.warning strong{font-size:clamp(10px,2.4vw,17px)}.article-text{font-size:clamp(10px,2.3vw,17px)!important;line-height:1.45!important}.indexrow{font-size:11px;padding:5px}.flower{font-size:24px}}
.article-video{display:block;width:100%;max-height:260px;margin:10px auto 16px;background:#241d28}.continued{font-family:Georgia,serif!important;font-size:clamp(15px,2vw,24px)!important}.spread>.page{min-width:0;overflow:hidden}.article-text{white-space:pre-wrap;overflow-wrap:anywhere;font-size:clamp(12px,1.45vw,17px);line-height:1.5}.article-banner{max-height:170px}.page{min-height:560px}.warning{max-width:100%;overflow-wrap:anywhere}@media(max-width:650px){.page{min-height:390px}.article-banner{max-height:95px}.article-video{max-height:140px}.page .date{font-size:10px}.page .article-actions button{font-size:9px;padding:4px}.page .notices{padding:6px;min-height:200px;font-size:11px}} 
.book{border:5px ridge #bd8c54;border-radius:12px;background:#d7a05e}
.spread{background-image:url("data:image/jpeg;base64,");background-size:100% 100%;background-repeat:no-repeat;aspect-ratio:1.5;min-height:0;align-items:stretch}
.spread>.page{background:transparent!important;box-shadow:none!important;min-height:0!important;border:0!important;padding:5.7% 8% 16% 8%;overflow:hidden;min-width:0;}
.spread>.page:first-child{border-right:2px solid #9a6c4570!important}
.page h2{font-family:'Brush Script MT','Segoe Print',Georgia,cursive;color:#301247;font-style:italic;font-size:clamp(15px,2.8vw,38px);margin:0 0 9px;line-height:1.1}
.page p,.article-text{font-size:clamp(10px,1.48vw,20px)!important;line-height:1.48!important;margin:7px 0}
.page .decor{border-bottom:2px solid #ae2844;padding-bottom:7px}
.warning{margin:6px auto!important;padding:7px!important;border:2px solid #2b1d1a!important;background:#f6d995b0!important;box-shadow:none!important}
.warning p{font-size:clamp(9px,1.23vw,16px)!important;line-height:1.35!important}
.warning strong,.warning b{font-size:clamp(9px,1.32vw,18px)!important}
.article-banner{max-height:32%;width:100%;object-fit:contain;border:2px solid #fff2cf;margin:5px 0}
.article-video{max-height:27%;margin:5px 0}
.article-text{white-space:pre-wrap;overflow-wrap:anywhere}
.indexrow{padding:4px 6px;font-size:clamp(9px,1.3vw,16px);margin:3px 0;background:#fffae7b0}
.flower{margin-top:10px;font-size:clamp(16px,2.5vw,35px)}
.toolbar button,.toolbar .filebtn,.nav button{font-size:10px;padding:4px 7px;border-radius:4px}
header{padding:8px 12px;gap:5px}header h1{font-size:clamp(15px,2.4vw,24px)}
.book-wrap{margin:6px auto;padding:0 6px}.nav{margin:4px auto;padding:4px 8px}.nav span{font-size:12px}
.notices{min-height:110px;padding:9px;border-width:1px}
@media(max-width:650px){.spread{aspect-ratio:1.22}.spread>.page{padding:7% 5.5% 17% 5.5%}.page h2{font-size:clamp(12px,3.6vw,21px)}.page p,.article-text{font-size:clamp(9px,2.15vw,13px)!important;line-height:1.32!important}.warning p{font-size:clamp(8px,1.9vw,11px)!important}.warning strong,.warning b{font-size:clamp(8px,1.9vw,11px)!important}.article-banner{max-height:30%}.indexrow{font-size:9px}.nav{position:static}.flower{font-size:16px}.page .decor{padding-bottom:3px}.notices{min-height:60px}}

/* v4: compact heading and warning kept inside facing parchment page */
header h1{font-size:clamp(12px,2.35vw,28px);white-space:nowrap;letter-spacing:-.035em;line-height:1.2}
.warning-intro{box-sizing:border-box;width:100%;max-width:100%;margin:5px 0 0;padding:8px 7px;border:2px solid #4b3327;overflow-wrap:break-word;text-align:center;background:rgba(246,206,115,.55)}
.warning-intro strong{display:block;font-size:clamp(10px,1.3vw,16px);line-height:1.25}
.warning-intro p{font-size:clamp(10px,1.28vw,15px);line-height:1.25;margin:9px 0}
.warning-intro .warning-ending{display:block;font-size:clamp(10px,1.25vw,16px);line-height:1.22;overflow-wrap:normal;word-break:normal}
@media(max-width:650px){
header h1{font-size:clamp(10px,2.25vw,16px);white-space:nowrap;letter-spacing:-.045em}
.warning-intro{padding:6px 5px;margin:4px 0 0;border-width:2px}
.warning-intro strong{font-size:clamp(9px,1.9vw,13px);line-height:1.15}
.warning-intro p{font-size:clamp(9px,1.85vw,12px);line-height:1.18;margin:7px 0}
.warning-intro .warning-ending{font-size:clamp(9px,1.75vw,12px);line-height:1.2}
}
<style>.welcome-heading{white-space:nowrap!important;overflow-wrap:normal!important;word-break:normal!important;font-size:clamp(10px,2.45vw,25px)!important;letter-spacing:-.045em!important}@media(max-width:650px){.welcome-heading{font-size:clamp(10px,2.45vw,16px)!important;letter-spacing:-.055em!important}}<style>@media(max-width:650px){.article-text{font-size:clamp(9px,1.75vw,12px)!important;line-height:1.25!important}.page .continued{font-size:12px!important}.article-video{max-height:150px!important}} .fixed-index{height:100%;display:flex;flex-direction:column;overflow:hidden}.fixed-index h2{font-size:clamp(17px,2.5vw,32px);margin-bottom:8px}.fixed-index .index-entries{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:flex-start;gap:clamp(2px,.5vh,7px);overflow:hidden}.fixed-index .indexrow{flex:0 1 auto;margin:0;padding:clamp(3px,.55vw,7px);font-size:clamp(10px,1.05vw,15px);line-height:1.15}.fixed-index .indexrow small{font-size:.75em}@media(max-width:650px){.fixed-index h2{font-size:clamp(12px,3vw,19px);margin-bottom:4px}.fixed-index .indexrow{font-size:clamp(8px,1.85vw,11px);padding:3px 2px;line-height:1.1}.fixed-index .index-entries{gap:2px}}

/* V17.13: match cover height to other spreads. */
.fullspread{aspect-ratio:1.5;min-height:0;overflow:hidden}
.fullspread img{width:100%;height:100%;display:block;object-fit:fill}
@media(max-width:650px){.fullspread{aspect-ratio:1.22}}
 .article-subtitle{font-size:clamp(10px,1.2vw,15px);font-weight:400;white-space:nowrap;text-align:center;margin-top:3px;}

/* V17.81 — consistent written headings; poster art intentionally excluded. */
.article-spread .article-text-heading{
 font-family:Arial,Helvetica,sans-serif!important;
 font-size:clamp(14px,1.65vw,25px)!important;
 font-weight:800!important;
 line-height:1.18!important;
 letter-spacing:.015em!important;
 text-align:center!important;
 text-transform:uppercase!important;
 margin:0 auto 9px!important;
 padding:0!important;
}
.article-spread .article-text-heading span{display:block!important;}
.article-spread .article-text-heading span+span{font-size:.8em!important;margin-top:4px!important;}
.fixed-index .index-art-row .index-title{
 font-family:Arial,Helvetica,sans-serif!important;
 font-weight:800!important;
 text-transform:uppercase!important;
 letter-spacing:0!important;
 line-height:1.14!important;
}

/* V2.41: scrollbar cosmetic change only */
.article-spread .article-scroll{margin-right:-10px!important;padding-right:15px!important;}
.article-spread>.page:nth-child(2)::after{content:"\25BC";position:absolute;right:1px;bottom:4px;font:bold 12px Arial,sans-serif;color:#9b7650;pointer-events:none;z-index:2;}
</style><style>
/* Stable page geometry: content is measured to the same dimensions as the visible page. */
.spread{aspect-ratio:1.23!important;min-height:0!important;height:auto!important}
.spread>.page{height:100%!important;min-height:0!important;overflow:hidden!important}
#page-measure{position:fixed!important;left:-10000px!important;top:0!important;z-index:-1!important;visibility:hidden!important;min-height:0!important;overflow:hidden!important;box-sizing:border-box!important}
.article-text{white-space:pre-wrap!important;overflow-wrap:break-word!important;margin-top:8px!important}
.article-cover{max-height:60%!important;width:100%!important;object-fit:contain!important}
@media(max-width:650px){
.spread>.page{padding:clamp(8px,2vw,13px)!important}
.article-text{font-size:clamp(10px,2.7vw,15px)!important;line-height:1.32!important}
.page h2{font-size:clamp(13px,3.2vw,22px)!important}
.article-video{max-height:115px!important}
}
</style><style>
/* One book spread per article: cover on the left, scrollable text on the right. */
.article-spread>.page{position:relative!important;overflow:hidden!important;}
.article-spread>.page:nth-child(2){display:flex!important;flex-direction:column!important;min-height:0!important;}
.article-spread .article-scroll{height:100%;min-height:0;max-height:100%;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;touch-action:pan-y;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:#9b7650 transparent;padding:0 5px 20% 0;}
.article-spread .article-scroll::-webkit-scrollbar{width:4px}
.article-spread .article-scroll::-webkit-scrollbar-thumb{background:#9b7650;border-radius:8px}
.article-spread .article-text{white-space:pre-wrap!important;overflow-wrap:anywhere!important;margin:0!important;padding-bottom:4px!important;}
.article-spread .article-cover-content{height:100%;overflow:hidden;}
.article-spread .article-cover{max-height:57%!important;object-fit:contain!important;}
.article-spread .article-video{max-height:48%!important;object-fit:contain!important;}
@media(max-width:650px){.article-spread .article-scroll{padding-bottom:25%!important;padding-right:3px!important}.article-spread .article-text{font-size:clamp(10px,2.7vw,15px)!important;line-height:1.32!important}}
</style><style>
.closing-spread>.page{overflow:hidden!important}
.closing-scroll{height:76%;max-height:76%;overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;padding-right:4px;scrollbar-width:thin;position:relative;z-index:1}
.closing-scroll p{font-size:clamp(11px,1.5vw,18px);line-height:1.4;margin:10px 0}
.closing-scroll h3{margin:14px 0 6px}
.closing-scroll .notices{min-height:40px;border-radius:8px;padding:8px;font-size:clamp(10px,1.3vw,15px)}
.donation-email{overflow-wrap:anywhere;font-weight:bold}
.donation-qr{display:block;width:min(100%,165px);height:auto;margin:6px auto;border:3px solid #d2ad73;background:white}
.closing-scroll .donation-small{font-size:clamp(9px,1.1vw,12px)}
@media(max-width:650px){.closing-scroll p{font-size:clamp(10px,2.2vw,14px);line-height:1.35}.closing-scroll .donation-qr{width:min(100%,112px)}.closing-scroll .page h2{font-size:15px}}
</style><style>.closing-scroll .why-book-title{font-size:clamp(11px,1.9vw,23px)!important;white-space:nowrap;letter-spacing:-.4px}@media(max-width:650px){.closing-scroll .why-book-title{font-size:clamp(10px,2.55vw,16px)!important;letter-spacing:-.5px}}</style><style>.why-book-banner{display:block;width:100%;height:auto;max-height:150px;object-fit:cover;object-position:center;border:2px solid #b68c4e;border-radius:5px;margin:7px 0 10px}@media(max-width:650px){.why-book-banner{max-height:95px}}</style>
<style>/* V17.05: accommodate the expanded poster index without clipping */ .fixed-index{overflow-y:auto!important;max-height:100%!important;} .fixed-index .index-entries{overflow-y:auto!important;max-height:82%!important;} .indexrow{font-size:clamp(9px,1.1vw,13px)!important;line-height:1.15!important;padding:3px 4px!important;} .article-spread .article-cover{object-fit:contain!important;max-height:72vh!important;}</style>
<style>
/* V17.07: consistent article poster placement regardless of title line count. */
.article-spread .article-cover-content{
 display:flex!important;flex-direction:column!important;height:100%!important;
 min-height:0!important;overflow:hidden!important;
}
.article-spread .article-title-slot{
 flex:0 0 118px!important;min-height:0!important;overflow:hidden!important;
}
.article-spread .article-title-slot .decor{margin-top:0!important;}
.article-spread .article-media-slot{
 flex:1 1 0!important;min-height:0!important;display:flex!important;
 flex-direction:column!important;align-items:center!important;justify-content:center!important;
 overflow:hidden!important;
}
.article-spread .article-media-slot .article-cover{
 display:block!important;width:100%!important;height:auto!important;
 max-height:75%!important;object-fit:contain!important;
 margin:0 auto!important;flex:0 1 auto!important;
}
.article-spread .article-media-slot .article-video{
 max-height:25%!important;max-width:100%!important;object-fit:contain!important;
 margin:4px auto!important;
}
@media(max-width:650px){
 .article-spread .article-title-slot{flex-basis:110px!important;}
}
</style>
<style>
/* V17.08: posters anchored to the vertical centre of the LEFT PAGE,
   independent of the number of title lines. */
.article-spread>.page:first-child{position:relative!important;}
.article-spread .article-cover-content{position:static!important;display:block!important;height:100%!important;}
.article-spread .article-title-slot{position:relative!important;z-index:2!important;height:auto!important;min-height:0!important;max-height:34%!important;overflow:hidden!important;}
.article-spread .article-media-slot{
 position:absolute!important;top:50%!important;left:6%!important;right:6%!important;
 width:88%!important;height:auto!important;max-height:55%!important;
 transform:translateY(-50%)!important;display:flex!important;flex-direction:column!important;
 align-items:center!important;justify-content:center!important;overflow:visible!important;
 flex:none!important;min-height:0!important;
}
.article-spread .article-media-slot .article-cover{
 display:block!important;width:100%!important;height:auto!important;max-height:100%!important;
 object-fit:contain!important;margin:0 auto!important;flex:none!important;
}
.article-spread .article-media-slot .article-video{max-height:110px!important;}
</style>
<style>
/* V17.17: centre posters for current articles 24 and 26 within the whole left page. */
.article-spread .center-poster-fix .article-media-slot{
  top:50%!important;left:6%!important;right:6%!important;
  width:88%!important;height:58%!important;max-height:58%!important;
  transform:translateY(-50%)!important;
  display:flex!important;align-items:center!important;justify-content:center!important;
}
.article-spread .center-poster-fix .article-media-slot .article-cover{
  width:100%!important;height:100%!important;max-height:100%!important;
  object-fit:contain!important;object-position:center center!important;
}
</style><style>
/* V17.20: Article 17's portrait poster fills more of the page while remaining centred. */
.article-spread .article-cover-content.article-17-poster .article-media-slot{
  top:50%!important; height:82%!important; max-height:82%!important;
  left:4%!important;right:4%!important;width:92%!important;
  transform:translateY(-50%)!important;
}
.article-spread .article-cover-content.article-17-poster .article-media-slot .article-cover{
  width:100%!important;height:100%!important;max-height:100%!important;
  object-fit:contain!important;object-position:center center!important;
}
</style><style>
/* V17.21: match Article 24 portrait poster sizing to Article 17, keeping it centred. */
.article-spread .article-cover-content.article-24-poster .article-media-slot{
 top:50%!important;height:82%!important;max-height:82%!important;
 left:4%!important;right:4%!important;width:92%!important;
 transform:translateY(-50%)!important;
}
.article-spread .article-cover-content.article-24-poster .article-media-slot .article-cover{
 width:100%!important;height:100%!important;max-height:100%!important;
 object-fit:contain!important;object-position:center center!important;
}
</style><style>
/* V17.22: full-size centred poster for original articles 17, 24, 36;
   follows each article even when the reading order changes. */
.article-spread .article-cover-content.large-centered-poster .article-media-slot{
 top:50%!important;left:4%!important;right:4%!important;width:92%!important;
 height:82%!important;max-height:82%!important;transform:translateY(-50%)!important;
 display:flex!important;align-items:center!important;justify-content:center!important;
}
.article-spread .article-cover-content.large-centered-poster .article-media-slot .article-cover{
 width:100%!important;height:100%!important;max-height:100%!important;
 object-fit:contain!important;object-position:center center!important;
}
</style><style>
/* V17.30 — consistent mobile-portrait poster presentation.
   All original artwork is preserved, without cropping away embedded lettering.
   Video spreads and closing pages retain their previous design. */
.article-spread .unified-poster{position:absolute!important;inset:0!important;height:100%!important;width:100%!important;overflow:hidden!important;padding:0!important;background:#153d44!important}
.article-spread .unified-poster .article-media-slot{position:absolute!important;inset:0!important;top:0!important;left:0!important;right:0!important;width:100%!important;height:100%!important;max-height:none!important;transform:none!important;display:block!important;margin:0!important}
.article-spread .unified-poster .poster-fullpage{position:relative;width:100%;height:100%;overflow:hidden;background:linear-gradient(155deg,#0f4a56,#f0b46c 80%,#614266)}
.article-spread .unified-poster .poster-backdrop{position:absolute;inset:-8%;width:116%;height:116%;object-fit:cover;filter:blur(22px) brightness(.68) saturate(.8);opacity:.8}
.article-spread .unified-poster .poster-foreground{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;filter:drop-shadow(0 2px 7px rgba(0,0,0,.35))}
