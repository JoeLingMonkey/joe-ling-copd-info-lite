@media(max-width:650px){.fixed-index h2{font-size:clamp(11px,3vw,19px)!important;padding:2px 0 4px!important}.fixed-index .indexrow.index-art-row{grid-template-columns:minmax(16px,14%) minmax(18px,20%) minmax(0,1fr)!important;gap:2px!important;padding:1px!important}.index-art-row .index-number{font-size:clamp(6px,1.7vw,10px)!important;padding:2px 0}.index-art-row .index-title{font-size:clamp(6px,1.75vw,10px)!important}.index-art-row .index-thumb{max-height:29px}}
