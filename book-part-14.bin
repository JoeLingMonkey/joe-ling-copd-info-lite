";
 if(viewArticles[17]) viewArticles[17].image="data:image/webp;base64,";
 if(viewArticles[18]) viewArticles[18].image="data:image/webp;base64,";
 if(viewArticles[19]) viewArticles[19].image="data:image/webp;base64,";
 // V2.24: Replace only Article 24 and 25 images.
 if(viewArticles[23]) viewArticles[23].image="data:image/webp;base64,";
 if(viewArticles[24]) viewArticles[24].image="data:image/webp;base64,";
 // V2.34: Keep the first 19 articles unchanged; restore the requested ending sequence.
 // Article 20 from V2.33 is removed. Existing app/video article objects are reused.
 {
   const tail=viewArticles.slice(20);
   const take=(predicate)=>{const i=tail.findIndex(predicate);return i<0?null:tail.splice(i,1)[0];};
   const app=take(a=>/emergency app|copd app|when fear, frustration and love collide/i.test(a.title||""));
   // V2.37: Retain the app page; remove the unrelated heading only.
   if(app){
     app.image="data:image/jpeg;base64,"; // V2.44: restore user-supplied original COPD Emergency App poster
     if(/when fear, frustration and love collide/i.test(app.title||"")) app.title="COPD Emergency App";
     if(typeof app.text==="string") app.text=app.text.replace(/(?:^|\\n)𝗪𝗛𝗘𝗡 𝗙𝗘𝗔𝗥, 𝗙𝗥𝗨𝗦𝗧𝗥𝗔𝗧𝗜𝗢𝗡 𝗔𝗡𝗗 𝗟𝗢𝗩𝗘 𝗖𝗢𝗟𝗟𝗜𝗗𝗘 ❤️(?=\\n|$)/g,"");
   }
   const one=take(a=>/one breath|last breath of a traveller/i.test(a.title||"")) || originalArticles.find(a=>a.video==="builtin-life-in-verse");
   const apocalypse=take(a=>a.video==="builtin-apocalypse" || /apocalypse|night of/i.test(a.title||""));
   const copd=take(a=>/understanding the invisible struggle|copd video/i.test(a.title||"")) || originalArticles.find(a=>a.video==="builtin-invisible-struggle");
   viewArticles=[...viewArticles.slice(0,19),...[app,one,apocalypse,copd].filter(Boolean)];
 }

 viewArticles.forEach((a,i)=>{
   if(a._slotEmpty){p.push(spread(`<div class="article-cover-content"><div class="article-media-slot" style="display:flex;align-items:center;justify-content:center;height:100%"><button onclick="slotEditor(${i})" style="font-size:1.3rem;padding:1.2rem 2rem">＋ Add Article ${i+1}</button></div></div>`,`<div class="article-scroll" style="display:flex;align-items:center;justify-content:center"><button onclick="slotEditor(${i})" style="font-size:1.3rem;padding:1.2rem 2rem">＋ Add Article ${i+1}</button></div>`).replace('class="spread"','class="spread article-spread"'));starts[i]=p.length-1;return;}
   starts[i]=p.length;
   const title=`<h2 class="decor"${a._twoLineTitle?' style="white-space:pre-line"':''}>${esc(a._twoLineTitle?String(a.title).split("\n").map(uniformHeading).join("\n"):uniformHeading(a.title))}</h2>${a._subtitle?`<div class="article-subtitle">${esc(a._subtitle)}</div>`:""}${i===0?"":`<div class="date">${esc(a.date)}</div>`}`;
   const media=(a.image?`<img class="article-banner article-cover" src="${a.image}" alt="Article banner">`:'')+(a._slotFilled?slotVideoMarkup(a):videoMarkup(a));
   const isVideoPage=!!a.video;
   const left=isVideoPage
     ? `<div class="article-cover-content${a._largeCenteredPoster?' center-poster-fix large-centered-poster':''}"><div class="article-title-slot">${a._hideLeftTitle?'':title}</div><div class="article-media-slot">${media||'<div class="flower">🌴 🐒 🌺</div>'}</div></div>`
     : `<div class="article-cover-content unified-poster ${/cough|coffee|piña|cappuccino/i.test(a.title||"")?'poster-club':/oxygen|inhaler|medic|rehab|breath|rescue|treatment|herbs|oximeter|lung|airway|COPD vs|symptom|tips|impairment|bronchial/i.test(a.title||"")?'poster-info':'poster-story'}"><div class="article-media-slot">${a.image?`<div class="poster-fullpage"><img class="poster-backdrop" src="${a.image}" alt="" aria-hidden="true"><img class="poster-foreground" src="${a.image}" alt="Article poster"></div>`:'<div class="flower">🌴 🐒 🌺</div>'}</div></div>`;
   const right=`<div class="article-scroll" tabindex="0" aria-label="Scroll article text"><div class="article-text"><h2 class="decor article-text-heading${i===0?' article-one-heading':''}">${i===0?'<span>GREETINGS EVERYONE</span><span>LET ME INTRODUCE MYSELF</span>':esc(uniformHeading(a.title))}</h2>${a.date?`<div class="date">${esc(a.date)}</div>`:''}</div><div class="article-text">${((a._slotFilled)?v1795TextMarkup(a,i):(a._v1705Poster && !a._article2FullText && i!==7 && i!==16 && i!==18 && i!==19 && i!==49)?'':v1795TextMarkup(a,i)).replace(/https:\/\/joelingmonkey\.github\.io\/copd-emergency-app-\//g,'<a href="https://joelingmonkey.github.io/copd-emergency-app-/" target="_blank" rel="noopener noreferrer">Open the free COPD Emergency App ↗</a>')}</div></div>`;
   p.push(spread(left,right).replace('class="spread"','class="spread article-spread"'));
 });
 // Two fixed index spreads (four paper pages), with no scrolling.
 // Each article keeps its correct navigation target after the extra index spread.
 const entries=viewArticles.map((a,i)=>`<button class="indexrow index-art-row" onclick="go(${starts[i]-1})"><span class="index-number">${i+1}</span>${a.image?`<img class="index-thumb" src="${a.image}" alt="" loading="lazy">`:`<span class="index-thumb index-no-thumb">📖</span>`}<span class="index-title">${esc(a._slotEmpty?"Add Article":uniformHeading(a.title))}</span></button>`);
 // V2.03: one scrollable table of contents, no lost article links.
 const singleIndex=`<div class="fixed-index"><h2 class="decor">My COPD Journey</h2><div class="index-entries">${entries.join('')}</div></div>`;
 p[2]=spread(singleIndex,'');
 p.splice(3,1);
 Object.keys(starts).forEach(k=>starts[k]--);
 p.push(spread(
  `<div class="closing-scroll"><h2 class="decor why-book-title">Why I made this book ❤️</h2><img class="why-book-banner" src="data:image/webp;base64," alt="Joe writing beside the sea, with his monkey, coffee and reasons for making the book">
  <p>Over the years I've written quite a lot about living with COPD. Not so much about the medical side, but about the everyday challenges, frustrations, little victories and occasional absurdities that come with it.</p>
  <p>I wanted to bring my writings together in one place, rather than have them disappear somewhere down my Facebook timeline.</p>
  <p>Writing also gives me something worthwhile to do. It keeps my mind active, gives me a purpose and helps me make sense of my own experiences. And if something I've learned along the way helps just one other person feel a little less alone, then it's been worth the effort.</p>
  <p>I'm not a doctor, and I'm certainly no miracle worker. Just an old traveller on Koh Phangan, taking life one breath at a time, preferably with a cappuccino nearby. 😜☕</p>
  <p>Thank you for reading, and for being part of the journey. ❤️🤗</p>
  <h3>Notices</h3><div class="notices closing-notices">${esc(data.notices||'')}</div><p><button onclick="openNotices()">Edit notices</button></p></div>`,
  `<div class="closing-scroll"><h2 class="decor">Buy me a coffee? ☕</h2><img class="why-book-banner" src="data:image/webp;base64," alt="Cappuccino at a Koh Phangan sunset, supporting my writing and COPD projects">
  <p>Keeping this book going costs time and energy, and as anyone living with COPD knows, the illness itself isn't exactly cheap either. Medications, oxygen, equipment and all the little extras soon add up.</p>
  <p>Everything here is free to read, and always will be. If you've found something useful, or simply enjoyed my ramblings, and feel like treating me to a cappuccino, I'd be very grateful. No pressure whatsoever. ❤️</p>
  <p><strong>PayPal:</strong><br><span class="donation-email">libertin98@yahoo.co.uk</span></p>
  <p><strong>Wise / donation QR code:</strong></p>
  <img class="donation-qr" src="${DONATION_QR}" alt="Donation QR code supplied by Joe Ling">
  <p class="donation-small">Please check the recipient details in your payment app before sending anything.</p>
  <p>And if a donation isn't possible, a kind word, a shared article or a friendly hello is just as welcome. 🐒❤️</p></div>`
 ).replace('class="spread"','class="spread closing-spread"')); 
 return {p,starts};
}
function ensureMeasure(){
 let el=document.getElementById('page-measure');
 if(!el){
  el=document.createElement('div');el.id='page-measure';el.className='page';
  el.innerHTML='<div class="measure-header"></div><div class="article-text"></div>';
  document.body.appendChild(el);
 }
 refreshMeasure();
}
// V2.03: Each parchment side is now a separate, larger reader page.
function readerPages(p){
 const pages=[];
 p.forEach((html,i)=>{pages.push({spread:i,side:0});if(i!==0&&i!==2)pages.push({spread:i,side:1});});
 return pages;
}
function pageForSpread(i,side=0){return readerPages(buildPages().p).findIndex(x=>x.spread===i&&x.side===side)}
function render(){
 ensureMeasure();
 const {p,starts}=buildPages(),map=readerPages(p);
 current=Math.max(0,Math.min(current,map.length-1));
 const target=map[current],holder=document.getElementById('book');
 if(target.spread===0){holder.innerHTML=p[0].replace('class="fullspread"','class="fullspread single-cover"');}
 else{
  const template=document.createElement('template');template.innerHTML=p[target.spread];
  const spreadEl=template.content.querySelector('.spread');
  const pages=spreadEl?spreadEl.querySelectorAll(':scope > .page'):[];
  const chosen=pages[target.side];
  if(chosen){spreadEl.replaceChildren(chosen);spreadEl.classList.add('single-page');if(target.spread===2)spreadEl.classList.add('single-index-spread');holder.replaceChildren(spreadEl)}
 }
 document.getElementById('prev').disabled=current===0;
 document.getElementById('next').disabled=current===map.length-1;
 const articleIndex=Object.keys(starts).reverse().find(k=>starts[k]<=target.spread);
 document.getElementById('position').textContent=target.spread===0?'Front cover':target.spread===1?(target.side===0?'Welcome':'Health warning'):target.spread===2?'Contents':target.spread===p.length-1?'Notices':articleIndex!==undefined?`Article ${Number(articleIndex)+1} — ${target.side===0?'Picture':'Text'}`:'';
 document.querySelectorAll('video[data-video]').forEach(async v=>{if(v.dataset.video==='builtin-invisible-struggle'||v.dataset.video==='builtin-life-in-verse')return;try{let blob=await getVideo(v.dataset.video);if(blob){v.src=blob}}catch(e){}});
 window.scrollTo({top:0,behavior:'smooth'});
}
window.addEventListener("resize",()=>render());
function turn(d){current+=d;render()}
function go(i){current=pageForSpread(i);if(current<0)current=0;render()}
function showIndex(){go(2)}
function closeModal(){document.getElementById('overlay').classList.remove('show')}
function showModal(s){document.getElementById('modal').innerHTML=s;document.getElementById('overlay').classList.add('show')}
// No browser database: newly selected videos become inline data URLs.
async function storeVideo(id,blob){return await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>{inlineVideos[id]=r.result;resolve()};r.onerror=reject;r.readAsDataURL(blob)})}
const inlineVideos=Object.create(null);
async function getVideo(id){return inlineVideos[id]||null}
function openEditor(i=-1){
 let a=i>=0?data.articles[i]:{title:'',date:new Date().toISOString().slice(0,10),text:'',image:'',video:''};
 showModal(`<h2>${i>=0?'Edit':'Add'} article</h2><p class="muted">Changes remain in memory until you export the complete HTML book. Videos are embedded in the HTML when you use Export Complete Book.</p><label>Article title</label><input id="atitle" value="${esc(a.title)}"><label>Date</label><input type="date" id="adate" value="${esc(a.date)}"><label>Banner picture</label><input type="file" id="apic" accept="image/*"><label>Video (optional)</label><input type="file" id="avideo" accept="video/*"><p class="muted">${a.video?'Existing video retained unless replaced. ':''}For videos, use a reasonably small MP4 file. Videos remain in this browser's storage, not in the exported JSON backup.</p><label>Complete article</label><textarea id="atext" rows="12">${esc(a.text)}</textarea><div class="actions"><button onclick="saveArticle(${i})">Save article</button>${i>=0?`<button onclick="deleteArticle(${i})">Delete</button>`:''}<button onclick="closeModal()">Cancel</button></div>`);
}
async function saveArticle(i){
 let title=document.getElementById('atitle').value.trim(),date=document.getElementById('adate').value,text=document.getElementById('atext').value;
 if(!title){alert('Please enter a title');return}
 let image=i>=0?data.articles[i].image:'',video=i>=0?data.articles[i].video:'';
 let file=document.getElementById('apic').files[0];
 if(file){image=await new Promise((resolve,reject)=>{let reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=reject;reader.readAsDataURL(file)})}
 let videoFile=document.getElementById('avideo').files[0];
 if(videoFile){try{video=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(videoFile)})}catch(e){alert('Video could not be saved on this device: '+e.message);return}}
 let a={title,date,text,image,video};
 if(i<0){data.articles.push(a)}else{data.articles[i]=a}
 save();closeModal();
 current=buildPages().starts[i<0?data.articles.length-1:i];render();
}
function deleteArticle(i){if(confirm('Delete this article? Export a backup first if you may want it later.')){data.articles.splice(i,1);save();closeModal();showIndex()}}function openNotices(){showModal('<h2>Notices</h2><p>Write news, updates or messages for readers.</p><textarea id="ntext">'+esc(data.notices)+'</textarea><div class="actions"><button onclick="data.notices=document.getElementById(\'ntext\').value;save();closeModal();go(3)">Save notices</button><button onclick="closeModal()">Cancel</button></div>')}
function exportBook(){let blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='joe-ling-copd-book-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}function importBook(e){let f=e.target.files[0];if(!f)return;let reader=new FileReader();reader.onload=()=>{try{let x=JSON.parse(reader.result);if(!Array.isArray(x.articles))throw Error('Invalid backup');if(confirm('Replace the articles and notices currently saved in this browser with this backup?')){data=x;save();current=3;render()}}catch(err){alert('Unable to read this backup: '+err.message)}};reader.readAsText(f);e.target.value=''}// V17.13: horizontal swipes turn pages; vertical scrolling remains available.
(function(){
 const book=document.getElementById('book');
 let startX=0,startY=0,tracking=false;
 book.addEventListener('touchstart',function(e){
   if(e.touches.length!==1 || e.target.closest('button,a,input,textarea,select,video,[contenteditable="true"]')){tracking=false;return;}
   startX=e.touches[0].clientX;startY=e.touches[0].clientY;tracking=true;
 },{passive:true});
 book.addEventListener('touchend',function(e){
   if(!tracking || e.changedTouches.length!==1)return;
   tracking=false;
   const dx=e.changedTouches[0].clientX-startX;
   const dy=e.changedTouches[0].clientY-startY;
   if(Math.abs(dx)>=55 && Math.abs(dx)>Math.abs(dy)*1.35)turn(dx<0?1:-1);
 },{passive:true});
 book.addEventListener('touchcancel',function(){tracking=false;},{passive:true});
})();
document.addEventListener('keydown',e=>{if(document.getElementById('overlay').classList.contains('show')){if(e.key==='Escape')closeModal();return}if(e.key==='ArrowRight')turn(1);if(e.key==='ArrowLeft')turn(-1)});render();
</script></body></html>